# =================================================================
# api-fuzzer-alan-vo Environment Configuration
# =================================================================

# Server Settings
HOST=127.0.0.1
PORT=8000
APP_ENV=development
DEMO_MODE=true

# SQLite Persistent Database
DATABASE_PATH=./data/fuzzer.db

# Authentication & OIDC Settings
JWT_SECRET=
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/api-fuzzer
OIDC_CLIENT_ID=api-fuzzer-app
OIDC_AUDIENCE=api-fuzzer-app

# Multi-Provider LLM Configuration (Optional: Deterministic Core runs without keys)
# LLM_API_KEY is the only secret credential variable.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30.0
